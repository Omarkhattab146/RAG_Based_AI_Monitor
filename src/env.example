APP_NAME=mini-rag-omar
APP_VERSION=0.1.0

FILE_ALOWED_EXTENSTIONS=["application/pdf","text/plain","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=5242880
FILE_DEFAULT_CHUNK_SIZE=1000
FILE_CHUNK_OVERLAP=100


MONGO_URI=mongodb://admin:admin@localhost:27007
MONGODB_DATABASE=mini_rag

# LLM Config
GENERATION_BACKEND=COPILOT
EMBEDDING_BACKEND=SentenceTransformer
GITHUB_TOKEN=""
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
COPILOT_NUM_PARALLEL=4
COPILOT_CONTEXT_LENGTH=4096
COPILOT_REQUEST_GAP_SECONDS=1.0
COPILOT_ENDPOINT=https://models.github.ai/inference
COPILOT_MODEL=openai/gpt-4.1-mini

GENERATION_MODEL_ID=openai/gpt-4.1-mini
EMBEDDING_MODEL_ID = BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_SIZE = 768


INPUT_DEFAULT_MAX_CHARACTERS=1024
# may to reduce
GENERATION_DEFAULT_MAX_TOKENS=3000
GENERATION_DEFAULT_TEMPRETURE=0.0
GENERATION_CONTEXT_MAX_CHARS=12000
GENERATION_CONTEXT_MAX_CHUNKS=12

# VectorDB config
VECTOR_DB_BACKEND=QDRANT
VECTOR_DB_PATH=./assets/database/quadrant_db
VECTOR_DB_DISTANCE_METHOD=cosine

# Ollama config (MCQ Generation)  (best untill now)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=512
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=2048

# Retrieval filtering
RETRIEVAL_TOP_K=20
RETRIEVAL_SCORE_THRESHOLD=0.5

# Template config
PRIMARY_LANG=en
DEFAULT_LANG=en

# Main backend (webhook target for presigned upload status).
# BACKEND_WEBHOOK_BASE_URL=https://localhost:7080
# BACKEND_WEBHOOK_BASE_URL=https://ailern.runasp.net
# Local ASP.NET dev HTTPS uses a self-signed cert; disable verify only for that case:
# BACKEND_WEBHOOK_VERIFY_SSL=false
# Webhook POST retries (transient 5xx / 408 / 429 / network errors)
# BACKEND_WEBHOOK_MAX_ATTEMPTS=3
# BACKEND_WEBHOOK_RETRY_INITIAL_SECONDS=1.0
# BACKEND_WEBHOOK_RETRY_MAX_SECONDS=30.0